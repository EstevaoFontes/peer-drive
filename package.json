{
  "name": "pee-drive",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint:ox": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.config.integration.ts",
    "migration:up": "dotenv -e .env -- tsx src/modules/core/infrastructure/database/migration.ts up",
    "migration:down": "dotenv -e .env -- tsx src/modules/core/infrastructure/database/migration.ts down",
    "migration:pending": "dotenv -e .env -- tsx src/modules/core/database/migration.ts pending",
    "migration:test:up": "dotenv -e .env.test -- tsx src/modules/core/infrastructure/database/migration.ts up",
    "migration:test:down": "dotenv -e .env.test -- tsx src/modules/core/infrastructure/database/migration.ts down",
    "migration:test:pending": "dotenv -e .env.test -- tsx src/modules/core/infrastructure/database/migration.ts pending"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/sequelize": "^12.0.1",
    "bcrypt": "^6.0.0",
    "cpf-cnpj-validator": "^2.1.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "validator": "^13.15.35",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^7.0.0",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}